<service>
  <!-- 1. サービスの基本情報（システム内で一意にする） -->
  <id>LoulanDNSDBService</id>
  <name>LoulanDNS DB Service</name>
  <description>LoulanDNS DB Service</description>

  <!-- 2. 実行対象（cmd.exe を経由してbatをキックする） -->
  <executable>cmd.exe</executable>

  <!-- コマンド引数の設定 -->
  <argument>/c</argument>

  <!-- %BASE% はこのXML（WinSW）が置いてある絶対パスに自動置換される -->
  <argument>"%BASE%\..\..\..\bin\db\server\HSQLDBServerMode.bat"</argument>

  <!-- 4. ログ出力設定（オプション） -->
  <!-- javaの標準出力・エラーを logs フォルダに自動保存（日次ローテーション） -->
  <log mode="roll-by-time">
    <pattern>yyyyMMdd</pattern>
  </log>
</service>